{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epico-site-docs",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "tutoriais.epico.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
